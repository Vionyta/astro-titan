---
import { getCollection } from 'astro:content';
import { projSetting } from '@data/config';
import PaginatedProjLayout from '@components/proj/PaginatedProjLayout.astro';
export const prerender = true;

// Get static paths for all possible pages
export async function getStaticPaths() {
	const allPosts = await getCollection('proj');

	// Filter posts
	const filteredPosts = allPosts.filter((post) => {
		return import.meta.env.DEV || post.data.project !== false;
	});

	// Sort posts by date
	const sortedPosts = filteredPosts.sort(
		(a, b) => b.data.projectDate.valueOf() - a.data.projectDate.valueOf(),
	);

	const totalPosts = sortedPosts.length;
	const totalPages = Math.ceil(totalPosts / projSetting.postsPerPage);

	// Create paths for all pages except page 1 (which is handled by index.astro)
	return Array.from({ length: totalPages - 1 }, (_, i) => {
		const page = i + 2; // Start from page 2
		const start = (page - 1) * projSetting.postsPerPage;
		const end = start + projSetting.postsPerPage;

		return {
			params: { page: String(page) },
			props: {
				page,
				totalPages,
				posts: sortedPosts.slice(start, end),
			},
		};
	});
}

const { page, totalPages, posts } = Astro.props;

// Redirect page 1 to the main projects page
if (page === 1) {
	return Astro.redirect('/projects');
}
---

<PaginatedProjLayout
	{posts}
	currentPage={page}
	{totalPages}
	baseUrl="/projects"
	title="Projects"
	subtitle="List of Projects that I handle, deployed or managed"
/>
