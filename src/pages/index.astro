---
import Layout from '@layouts/Layout.astro';
import Hero from '@components/sections/Hero.astro';
//import SplitPanel from '@components/sections/SplitPanel.astro';
import Features from '@components/sections/Features.astro';
import ExperienceTimeline from '@components/sections/ExperienceTimeline.astro';
import { featureLists } from '@data/features';
import Logos from '@components/sections/Logos.astro';
import { logoLists } from '@data/logos';
import heroImage from '@assets/images/home/default-hero-2.jpg';
import styleGuideImage from '@assets/images/home/wed_800x600.jpg';

const seoTitle = 'About Victor Ong Wai Kit';
const seoDescription = 'Interactive website to present Victor Ong Resume';

//const styleGuideSection = {
//	eyebrow: 'About me',
//	headline: 'Home in Phnom Pehn',
//	description:
//		'My wife and I decided to relocate permanently to her home in Phnom Penh—a move that has enriched both my personal and professional life. This gives me a distinct advantage: the ability to apply my specialized knowledge within the context of local Khmer culture, ensuring my work is always culturally resonant and impactful.',
//	image: {
//		src: styleGuideImage,
//		alt: 'Featured image',
//	},
//};

const heroContent = {
	title: 'Hello, I am Victor Ong, CISSP #731611',
	description:
		'Over 20 years experince in Design, Deploy & Manage "Carrier Grade Core Network and Services (WiMAX@Pre-4G and FTTH/FTTO)", to National/International Internet Exchange (IX), then finally landed in Cyber Security realm. My career journey cover from end-user, system integrator, value-added distributor, to International CyberSecurity Vendor',
	buttons: [
		{
			text: 'Career History',
			link: '/company',
			target: '_self',
		},
		{
			text: 'Projects',
			link: '/projects',
			target: '_self',
		},
		{
			text: 'My Certificates',
			link: '/cert',
			target: '_self',
		},
	],
	backgroundImage: heroImage,
	overlayOpacity: 0.2,
};

const featuresSection = {
	eyebrow: 'Core Focus',
	title: 'Cybersecurity Leadership & Innovation',
	description:
		'Experience spanning the entire digital defense spectrum, I have evolved from an ISP Core Infrastructure Engineer into a Cybersecurity Leader and CISSP-certified expert. My career is defined by a unique Carrier-Grade perspective , blending deep technical roots in telco-scale networks with the strategic commercial management of Managed Security Service Providers and Systems Integration (SI) divisions.',
	features: featureLists.main.features,
};

const logosSection = {
	eyebrow: 'Products I work with',
	logos: logoLists.main.logos,
};
---

<Layout title={seoTitle} description={seoDescription}>
	<Hero content={heroContent} />
	<Logos content={logosSection} background="base" padding="small" />
	<!-- <SplitPanel content={styleGuideSection} imagePosition="right" background="light" padding="base" /> -->
	<Features content={featuresSection} padding="base" background="light" />
	<ExperienceTimeline />
</Layout>
