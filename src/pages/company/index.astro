---
//import "@styles/global.css";
import { getCollection, render } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import InnerHero from '@components/sections/InnerHero.astro';
import contactHeroImage from '@assets/images/contact-hero.jpg';

const companies = await getCollection('company');
const sortedCompanies = companies.sort((a, b) => (a.data.order || 999) - (b.data.order || 999));

const companiesWithContent = await Promise.all(
	sortedCompanies.map(async (company) => {
		const { Content } = await render(company);
		return { ...company, Content };
	}),
);

const title = 'My Carreer History in Detail';
const description = 'Professional journey across various organizations, where I gain various precious knowledges.';

const heroContent = {
	title: title,
	description: description,
	backgroundImage: contactHeroImage,
	overlayOpacity: 0.2,
};

const background = ['base', 'light', 'mild', 'dark'] as const;
---

<Layout {title} {description}>
	<InnerHero content={heroContent} />
	<!-- Start list of companies -->
	<section class="py-base bg-background">
		<div class="site-container mx-auto px-4">
			<div class="max-w-4xl mx-auto">
				<div class="space-y-12">
					{
						companiesWithContent.map(({ data, Content }) => (
							<div
								class="bg-dark dark:bg-background-light rounded-2xl shadow-sm border border-gray-100 dark:border-gray-800 overflow-hidden"
								data-aos="fade-up"
							>
								<div class="p-8 md:p-10">
									<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6 pb-6 border-b border-gray-100 dark:border-gray-800">
										<div>
											<h2 class="text-2xl md:text-3xl font-bold text-headline dark:text-headline mb-2">
												{data.companyName}
											</h2>
											<div class="flex flex-wrap gap-3 items-center">
												<span class="text-large font-bold text-primary">{data.jobTitle}</span>
												<span class="text-gray-400">•</span>
												<span class="text-large text-gray-500 dark:text-gray-1000">
													{data.startDate} — {data.endDate}
												</span>
											</div>
											<div class="flex flex-wrap gap-3 items-center">
												<p class="text-white">.</p>
											</div>
											<div class="flex flex-wrap gap-3">
													<span class="px-4 py-1 rounded-full text-small font-medium bg-primary/10 text-primary border border-primary/20">
													{data.type}
													</span>
												{data.industry && (
													<span class="px-4 py-1 rounded-full text-small font-medium bg-gray-80 dark:bg-gray-800 text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-gray-700">
													{data.industry}
													</span>
												)}
												{data.coverage && (
													<span class="px-4 py-1 rounded-full text-small font-medium bg-secondary/10 text-secondary border border-secondary/20">
													{data.coverage}
													</span>
												)}
											</div>
										</div>
									</div>

									<article
										class="prose prose-lg dark:prose-invert max-w-none 
                                    prose-headings:text-headline dark:prose-headings:text-headline-dark prose-headings:font-bold prose-headings:mb-4 prose-headings:mt-8
                                    prose-p:text-body-base dark:prose-p:text-body-dark prose-p:leading-relaxed prose-p:mb-4
                                    prose-li:text-body-base dark:prose-li:text-body-dark prose-li:mb-2
                                    prose-strong:text-headline dark:prose-strong:text-headline-dark prose-strong:font-bold
                                    prose-ul:list-disc prose-ul:ml-6 prose-ul:mb-6
                                    "
									>
										<Content />
									</article>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</section>
</Layout>

