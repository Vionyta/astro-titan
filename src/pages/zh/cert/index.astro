---

<Layout {title} {description}>
    <InnerHero content={heroContent} />

    <section class="py-16 bg-white">
        <div class="site-container mx-auto px-4 max-w-5xl">
            <main class="space-y-16">
                
                <CertTable 
                    title="正规教育" 
                    headers={["颁发学校", "级别", "年份", "国际等级"]} 
                    rows={正规教育} 
                />

                <!--<hr class="border-slate-700" /> -->

                <CertTable 
                    title="网络安全相关证书" 
                    headers={["颁发机构", "证书名称", "年份"]} 
                    rows={网络安全} 
                />

                <CertTable 
                    title="云计算相关证书" 
                    headers={["颁发机构", "证书名称", "年份"]} 
                    rows={云计算} 
                />

                <CertTable 
                    title="系统管理相关证书" 
                    headers={["颁发机构", "证书名称", "年份"]} 
                    rows={系统管理} 
                />

                <CertTable 
                    title="网络相关证书" 
                    headers={["颁发机构", "证书名称", "年份"]} 
                    rows={网络} 
                />

            </main>
        </div>
    </section>
</Layout>