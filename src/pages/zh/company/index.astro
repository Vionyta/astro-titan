---
import { getCollection, render } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import InnerHero from '@components/sections/InnerHero.astro';
import contactHeroImage from '@assets/images/company-hero-wide.jpg';

const companies = await getCollection('company', ({ id }) => id.startsWith('zh/'));
const sortedCompanies = companies.sort((a, b) => (a.data.order || 999) - (b.data.order || 999));

const companiesWithContent = await Promise.all(
	sortedCompanies.map(async (company) => {
		const { Content } = await render(company);
		return { ...company, Content };
	}),
);

const title = '我的职业生涯';
const description = '我是如何在不同公司里历练成长，获得宝贵的知识和经验。';

const heroContent = {
	title: title,
	description: description,
	backgroundImage: contactHeroImage,
	overlayOpacity: 0.2,
};

//const background = ['base', 'light', 'mild', 'dark'] as const;
---

<Layout {title} {description}>
	<InnerHero content={heroContent} />
	<!-- Start list of companies -->
	<section class="py-base bg-background">
		<div class="site-container mx-auto px-4">
			<div class="max-w-4xl mx-auto">
				<div class="space-y-12">
					{
						companiesWithContent.map(({ data, Content }) => (
							<div class="bg-dark dark:bg-background-light rounded-2xl shadow-sm border border-gray-100 dark:border-gray-800 overflow-hidden" data-aos="fade-up">
								<div class="p-8 md:p-10">
									<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6 pb-6 border-b border-gray-100 dark:border-gray-800">
										<div>
											<div class="flex flex-wrap gap-1 items-baseline">
												<span class="text-4xl font-bold text-indigo-700">{data.companyName}</span>
												<span class="text-base text-gray-600">
													{data.startDate} — {data.endDate}
												</span>
												<span class="text-base font-bold text-indigo-500 mb-3">{data.jobTitle}</span>
											</div>
											<div class="flex flex-wrap gap-3 badge-container">
												<span class="bg-primary/10 text-primary border-primary/20">{data.type}</span>
												{data.industry && <span class="bg-gray-80 dark:bg-gray-800 text-gray-600 dark:text-gray-400 border-gray-200 dark:border-gray-700">{data.industry}</span>}
												{data.coverage && <span class="bg-secondary/10 text-secondary border-secondary/20">{data.coverage}</span>}
											</div>
										</div>
									</div>
									<article
										class="prose max-w-none 
									prose-headings:!text-indigo-700 prose-headings:!font-bold prose-headings:!mb-1 
									prose-p:!leading-relaxed prose-p:!mb-0 
									prose-li:!text-sm prose-li:!mb-0 
									prose-ul:!text-sm prose-ul:!list-disc prose-ul:!ml-6 prose-ul:!mb-0 prose-ul:!mt-0
									prose-ol:!text-sm prose-ol:!list-decimal prose-ol:!ml-6 prose-ol:!mb-0 prose-ol:!mt-0"
									>
										<Content />
									</article>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</section>
</Layout>

<style>
	@reference "@styles/global.css";

	.badge-container span {
		@apply px-4 py-1 rounded-full text-small font-medium border;
	}
</style>
