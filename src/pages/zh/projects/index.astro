---
import { getCollection } from 'astro:content';
import { projSetting } from '@data/config';
import { parseProjectDate } from '@utils/date';
import PaginatedProjLayout from '@components/proj/PaginatedProjLayout.astro';
export const prerender = true;

// Get current page from URL, default to 1
const currentPage = parseInt(Astro.url.searchParams.get('page') || '1');

// Get all posts without any filtering
const allPosts = await getCollection('proj', ({ id }) => id.startsWith('zh/'));

// Then apply filters if needed
const filteredPosts = allPosts.filter((post) => {
	return import.meta.env.DEV || post.data.publish !== false;
});

// Sort posts by date
 const sortedPosts = filteredPosts.sort((a, b) => {
	const dateA = parseProjectDate(a.data.projectDate);
	const dateB = parseProjectDate(b.data.projectDate);
	return dateB - dateA;
});


// Calculate pagination
const totalPosts = sortedPosts.length;
const totalPages = Math.ceil(totalPosts / projSetting.postsPerPage);
const start = (currentPage - 1) * projSetting.postsPerPage;
const end = start + projSetting.postsPerPage;
const paginatedPosts = sortedPosts.slice(start, end);
---

<PaginatedProjLayout
	posts={paginatedPosts}
	{currentPage}
	{totalPages}
	baseUrl="/zh/projects"
	title="项目经验"
	subtitle="Victor Ong所做过的项目"
/>
