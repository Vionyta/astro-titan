---
import { getCollection } from 'astro:content';
import PaginatedProjLayout from '@components/proj/PaginatedProjLayout.astro';
import { categories } from '@data/categories';
import { projSetting } from '@data/config';
import { parseProjectDate } from '@utils/date';

export async function getStaticPaths() {
	// Get all Chinese projects
	const allPosts = await getCollection('proj', ({ data, id }) => {
		const isPublished = import.meta.env.DEV || data.publish !== false;
		const isZh = id.startsWith('zh/');
		return isPublished && isZh;
	});

	// Get Chinese categories that have at least one project
	const activeCategories = categories.filter((category) =>
		category.lang === 'zh' && allPosts.some((post) => post.data.categories?.includes(category.slug)),
	);

	// Generate paths only for categories with projects
	return activeCategories.map((category) => ({
		params: { slug: category.slug },
		props: { category: category },
	}));
}

const { category } = Astro.props;
const currentPage = parseInt(Astro.url.searchParams.get('page') || '1');

// Get posts for this category
const allCategoryPosts = await getCollection('proj', ({ data, id }) => {
	const isPublished = import.meta.env.DEV || data.publish !== false;
	const isZh = id.startsWith('zh/');
	const hasCategory = data.categories?.includes(category.slug);
	return isPublished && isZh && hasCategory;
});

// Sort posts by date
 const sortedPosts = allCategoryPosts.sort((a, b) => {
	const dateA = parseProjectDate(a.data.projectDate);
	const dateB = parseProjectDate(b.data.projectDate);
	return dateB - dateA;
});

// Calculate pagination
const totalPosts = sortedPosts.length;
const totalPages = Math.ceil(totalPosts / projSetting.postsPerPage);
const start = (currentPage - 1) * projSetting.postsPerPage;
const end = start + projSetting.postsPerPage;
const paginatedPosts = sortedPosts.slice(start, end);
---

<PaginatedProjLayout
	posts={paginatedPosts}
	{currentPage}
	{totalPages}
	baseUrl={`/zh/category/${category.slug}`}
	title={category.name}
	subtitle={category.description}
	currentCategory={category.name}
/>
