---
import type { renderScript } from 'astro/runtime/server/index.js';
import { experience } from '../../data/experience';
import Layout from '@layouts/Layout.astro';
---

<section class="relative py-16">
	<div class="container mx-auto px-4">
		<h2 class="text-4xl font-bold text-center mb-4">Brief Working Experience</h2>
		<div class="relative wrap overflow-hidden p-10 h-full">
			<div
				class="border-2-2 absolute border-opacity-20 border-primary-500 h-full border"
				style="left: 50%"
			>
			</div>

			{
				experience.map((item, index) => (
					<div
						class={`mb-8 flex justify-between items-center w-full ${index % 2 === 0 ? 'flex-row-reverse left-timeline' : 'right-timeline'}`}
					>
						<div class="order-1 w-11/12" />
						<div class="z-20 flex items-center order-1 bg-primary-500 shadow-xl w-8 h-8 rounded-full" />
						<div
							class={`order-1 bg-base-100 rounded-lg shadow-xl w-11/12 px-6 py-4 timeline-card ${index % 2 === 0 ? 'text-left' : 'text-left'}`}
						>
							<h3 class="mb-3 font-bold text-large">{item.company}</h3>
							<h5 class="text-sm items-top text-gray-400">
								{item.startDate} - {item.endDate}
							</h5>
							<h4 class="mb-3 text-sm">{item.role}</h4>
							<h4 class="mb-3 text-sm">{item.scope}</h4>
							<ul class="list-disc list-inside text-sm">
								{item.responsibility.map((resp) => (
									<li class="mb-1">{resp}</li>
								))}
							</ul>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>

<script is:inline>
	document.addEventListener('DOMContentLoaded', () => {
		const timelineCards = document.querySelectorAll('.timeline-card');

		const observerOptions = {
			root: null,
			rootMargin: '0px',
			threshold: 0.2,
		};

		const observer = new IntersectionObserver((entries, observer) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					entry.target.classList.add('animate-fade-in-up');
					observer.unobserve(entry.target);
				}
			});
		}, observerOptions);

		timelineCards.forEach((card) => {
			card.classList.add('opacity-0', 'translate-y-4'); // Initial hidden state
			observer.observe(card);
		});
	});
</script>

<style>
	.wrap {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.timeline-card {
		transition:
			opacity 0.6s ease-out,
			transform 0.6s ease-out;
	}

	.animate-fade-in-up {
		opacity: 1;
		transform: translateY(0);
	}

	/* Responsive adjustments */
	@media (max-width: 768px) {
		.wrap .border {
			left: 8px !important;
		}
		.right-timeline,
		.left-timeline {
			justify-content: flex-end;
		}
		.right-timeline .timeline-card,
		.left-timeline .timeline-card {
			width: 90%;
		}
		.right-timeline .order-1,
		.left-timeline .order-1 {
			order: 1;
		}
		.right-timeline .order-1.w-5\/12,
		.left-timeline .order-1.w-5\/12 {
			display: none;
		}
		.right-timeline .z-20,
		.left-timeline .z-20 {
			left: 0;
			position: absolute;
		}
	}
</style>
