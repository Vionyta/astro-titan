---
// src/components/LanguagePicker.astro
const pathname = Astro.url.pathname;

// A simplistic way to swap the locale in the URL
function getAlternativeLocalizedUrl(targetLocale: string) {
	if (targetLocale === 'zh') {
        // If we are on english root URL, prefix with /zh
		return `/zh${pathname === '/' ? '' : pathname}`;
	} else {
        // Switching back to English: remove /zh prefix
		return pathname.replace(/^\/zh/, '') || '/';
	}
}
---

<div class="flex items-center gap-4">
  <a href={getAlternativeLocalizedUrl('en')} class="flex items-center gap-2 text-white text-base hover:text-yellow-400 transition-colors group">
    <svg class="w-5 h-auto rounded-xs shadow-md border border-white/10 group-hover:scale-110 transition-transform" viewBox="0 0 60 30" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,0 v30 h60 v-30 z" fill="#012169"/>
      <path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6"/>
      <path d="M0,0 L60,30 M60,0 L0,30" stroke="#C8102E" stroke-width="4"/>
      <path d="M30,0 v30 M0,15 h60" stroke="#fff" stroke-width="10"/>
      <path d="M30,0 v30 M0,15 h60" stroke="#C8102E" stroke-width="6"/>
    </svg>
    <span class="group-hover:underline">EN</span>
  </a>
  <span class="text-gray-700">|</span>
  <a href={getAlternativeLocalizedUrl('zh')} class="flex items-center gap-2 text-white text-base hover:text-yellow-400 transition-colors group">
    <svg class="w-5 h-auto rounded-xs shadow-md border border-white/10 group-hover:scale-110 transition-transform" viewBox="0 0 30 20" xmlns="http://www.w3.org/2000/svg">
      <rect width="30" height="20" fill="#ee1c25"/>
      <path d="M5,10 L5,2 L10,6 L2,6 L7,2 L7,10" fill="#ffff00" transform="translate(-1, -1) scale(0.6)"/>
    </svg>
    <span class="group-hover:underline">中文</span>
  </a>
</div>
