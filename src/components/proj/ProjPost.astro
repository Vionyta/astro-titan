---
import { getCategoryBySlug } from '@data/categories';
import HashtagCategory from '@components/ui/HashtagCategory.astro';
//import Date from '../ui/Date.astro';
import { Image } from 'astro:assets';

interface Props {
	title: string;
	projectSizing: string;
	excerpt: string;
	featuredImage: any; // Changed to accept ImageMetadata from content collections
	projectDate: string;
	categories: string[];
	slug?: string;
	descriptions: string;
	index: number;
}

const { title, projectSizing, featuredImage, projectDate, categories: postCategories, slug, excerpt, descriptions, index } = Astro.props;
const locale = Astro.currentLocale ?? 'en';

// Resolve full category objects from slugs to get names (localized)
const localizedCategories = postCategories.map((slug) => {
	const category = getCategoryBySlug(slug, locale);
	return category?.name || slug;
});
---

<a
	href={`/${locale === 'zh' ? 'zh/projects' : 'projects'}/${slug}`}
	class="group flex flex-col h-full overflow-hidden bg-white rounded-lg border border-black transition-all duration-300 hover:border-primary"
	data-aos="fade-up"
	data-aos-delay={index * 100}
>
	<div class="relative aspect-[16/9] overflow-hidden border-black border-b group-hover:border-primary transition-colors duration-300">
		{featuredImage && <Image src={featuredImage} alt="" width={600} height={338} class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-300" />}
		<div class="absolute inset-0 bg-primary opacity-0 group-hover:opacity-10 transition-opacity duration-300"></div>
	</div>

	<div class="py-4 px-4 flex flex-col flex-grow relative">
		{/* Date at the top */}
		<ol>
			<li class="text-sm text-gray-600 mb-1 group-hover:text-primary/80 transition-colors duration-300">{projectDate}</li>
			<li class="text-lg mb-0 font-bold text-gray-900 group-hover:text-primary transition-colors duration-300">{title}</li>
			<li class="mb-2 text-base font-bold text-gray-900 group-hover:text-primary transition-colors duration-300">Value: {projectSizing}</li>
			<li><p class="mt-2 mb-8 text-body-base line-clamp-4 flex-grow text-small group-hover:text-gray-700 transition-colors duration-300">{excerpt}</p></li>
			<!-- <li><p class="text-body-base text-small group-hover:text-primary transition-colors duration-300">{descriptions}</p></li> -->
			{/* Categories as hashtags at the bottom */}
			<li class="flex flex-wrap">
				{
					localizedCategories.map((categoryName) => (
						<div class="text-base text-red-500 category-tag">
							<HashtagCategory category={categoryName} />
						</div>
					))
				}
			</li>
		</ol>
	</div>
</a>
<script>
	document.querySelectorAll('div.category-tag').forEach((e) => e.addEventListener('click', (event) => event.stopPropagation()));
</script>
