---
import ProjPost from './ProjPost.astro';
import type { CollectionEntry } from 'astro:content';
import { categories, zhcategories } from '@data/categories';
import { getCollection } from 'astro:content';

interface Props { posts: CollectionEntry<'proj'>[]; currentCategory?: string; }

const { posts, currentCategory } = Astro.props;
const locale = Astro.currentLocale ?? 'en';
const isZh = locale === 'zh';

// Get current category list based on locale
const localeCategories = isZh ? zhcategories : categories;

// Get all posts for this locale to determine active categories
const allPosts = await getCollection('proj', ({ data, id }) => {
	const isPublished = import.meta.env.DEV || data.publish !== false;
	const matchesLocale = isZh ? id.startsWith('zh/') : !id.startsWith('zh/');
	return isPublished && matchesLocale;
});

// Filter to only show categories that have posts in this locale
const activeCategories = localeCategories.filter((category) =>
	allPosts.some((post) => post.data.categories?.includes(category.slug)),
);

const baseUrl = isZh ? '/zh/projects' : '/projects';
const categoryUrl = isZh ? '/zh/category' : '/category';
---

<section class="site-container mx-auto px-4 py-base">
	<div class="mb-16 flex flex-col sm:flex-row sm:justify-between sm:items-end gap-6" data-aos="fade-in" data-aos-delay="100">
		<div class="w-full">
			<h2 class="text-lg font-semibold mb-4">{isZh ? '按类别筛选：' : 'Filter by Categories:'}</h2>
			<div class="flex flex-wrap gap-2">
				<a
					href={baseUrl}
					class={`px-4 sm:px-6 py-2 sm:py-3 leading-none rounded-md text-small flex items-center justify-center transition-colors border border-primary duration-200 ${
						!currentCategory
							? 'bg-primary text-body-dark shadow-md'
							: 'bg-background text-body-base hover:bg-background-light hover:text-body-light'
					}`}
				>
					{isZh ? '显示全部' : 'Show All'}
				</a>
				{
					activeCategories.map((category) => (
						<a 
							href={`${categoryUrl}/${category.slug}`}
							class={`px-4 sm:px-6 py-2 sm:py-3 leading-none rounded-md text-small flex items-center justify-center transition-colors border border-primary duration-200 
								${currentCategory === category.name
									? 'bg-primary text-body-dark shadow-md'
									: 'bg-background text-body-base hover:bg-background-light hover:text-body-light'
							}`}
							title={category.description}
						>
							{category.name}
						</a>
					))
				}
			</div>
		</div>

		<p class="text-small text-body-base text-left sm:text-right whitespace-nowrap">
			{isZh ? '显示' : 'Showing'} <span class="font-bold text-primary">{posts.length}</span> {isZh ? '个' : 'of'} <span
				class="font-bold text-primary">{allPosts.length}</span
			> {isZh ? '项目' : 'posts'}
		</p>
	</div>

	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
		{
			posts.map((post, index) => (
				<div class="text-base">
					<ProjPost title={post.data.title}
						projectSizing={post.data.projectSizing}
						excerpt={post.data.excerpt}
						featuredImage={post.data.featuredImage || ''}
						projectDate={post.data.projectDate || ''}
						descriptions={post.data.descriptions || ''}
						categories={post.data.categories || []}
						slug={post.id}
						index={index}
					/>
				</div>
			))
		}
	</div>

	{
		posts.length === 0 && (
			<p class="text-center text-gray-500 py-8">{isZh ? '在此类别下未找到项目。' : 'No posts found in this category.'}</p>
		)
	}
</section>
