---
import { footerMenu } from '@data/menu'; //legalMenu removed
import Logo from '@components/Logo.astro';
import Button from '@components/ui/Button.astro';
import { siteConfig } from '@data/config';

interface ButtonProps {
	text: string;
	link: string;
	target?: string;
}

interface Props {
	footerCta?: {
		title: string;
		description: string;
		hideCta: boolean;
		button: ButtonProps;
	};
}

const { footerCta } = Astro.props;

const defaultCta = {
	title: 'Want to know more about my professional journey?',
	description: 'Click here for detail.',
	hideCta: false,
	button: {
		text: 'Companies',
		link: '/company',
		target: '_self',
	},
};

const cta = footerCta || defaultCta;
const currentYear = new Date().getFullYear();
---

<footer class={`bg-indigo-800 text-white pb-small ${cta.hideCta ? 'pt-large' : ''}`}>
	<div class="site-container mx-auto px-4">
		{
			!cta.hideCta && (
				<div class="bg-white rounded-lg border-indigo-700 text-center border-b mb-4 py-6">
					<h2 class="text-indigo-700 text-3xl font-bold mb-4" data-aos="fade-up">
						{cta.title}
					</h2>
					<p class="text-indigo-700 mb-6 max-w-2xl mx-auto" data-aos="fade-up" data-aos-delay="100">
						{cta.description}
					</p>
					<Button
						href={cta.button.link}
						variant="ghostFooter"
						size="lg"
						data-aos="fade-up"
						data-aos-delay="200"
						{...(cta.button.target && { target: cta.button.target })}
					>
						{cta.button.text}
					</Button>
				</div>
			)
		}

		<div class="grid grid-cols-1 md:grid-cols-3 gap-8 pb-8 border-b border-background-light">
			<div class="col-span-1 justify-between">
				<Logo variant="footer" />
				<ul>
					<li class="mt-1 text-white text-base font-bold underline">Contact</li>
					<li class="mt-1 text-white text-sm">Tel: +855 98 449 299</li>
					<li class="mt-1 text-white text-sm">Mail: waikitong168@gmail.com</li>
				</ul>
			</div>
			<div class="col-span-1 justify-between">
				<h3 class="text-lg font-semibold mb-4">Quick Links</h3>
				<nav>
					<ul class="space-y-2">
						{
							footerMenu.map((item) => (
								<li>
									<a href={item.link} class="text-body-dark hover:text-white transition-colors">
										{item.name}
									</a>
								</li>
							))
						}
					</ul>
				</nav>
			</div>
			<div class="col-span-1 justify-between"></div>
		</div>

		<div class="mt-8 flex flex-col md:flex-row justify-between items-center">
			<div class="text-body-dark text-sm">
				© {currentYear}
				Victor Ong Wai Kit. All rights reserved.
			</div>

			<!-- <nav class="mt-4 md:mt-0">
				<ul class="flex flex-wrap gap-6">
					{legalMenu.map(item => (
            <li>
              <a 
                href={item.link} 
                class="text-sm text-body-dark hover:text-white transition-colors">
                {item.name}
              </a>
            </li>
          ))}
        </ul>
				</ul>
			</nav> -->
		</div>
	</div>
</footer>
