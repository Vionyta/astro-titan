{
	"name": "titan-core",
	"type": "module",
	"version": "2.1.0",
	"private": true,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/withastro/astro.git"
	},
	"scripts": {
		"format": "prettier -w .",
		"check": "astro check",
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro"
	},
	"workspaces": [
		"packages/markdown/*",
		"packages/integrations/*",
		"packages/*",
		"packages/language-tools/*"
	],
	"engines": {
		"node": ">=22.12.0"
	},
	"packageManager": "pnpm@10.33.0",
	"dependencies": {
		"aos": "^2.3.4",
		"astro-icon": "^1.1.5",
		"tailwindcss": "^4.2.2"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.8",
		"@astrojs/sitemap": "^3.7.2",
		"@biomejs/biome": "2.4.2",
		"@emnapi/core": "^1.9.2",
		"@lucide/astro": "^1.7.0",
		"@tailwindcss/vite": "^4.2.2",
		"@types/aos": "^3.0.7",
		"astro": "^5.18.1",
		"bgproc": "^0.2.0",
		"esbuild": "0.27.0",
		"eslint": "^9.39.4",
		"eslint-plugin-regexp": "^3.1.0",
		"knip": "5.82.1",
		"only-allow": "^1.2.2",
		"prettier": "^3.8.1",
		"prettier-plugin-astro": "^0.14.1",
		"publint": "^0.3.18",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.58.0",
		"valibot": "^1.3.1"
	}
}
